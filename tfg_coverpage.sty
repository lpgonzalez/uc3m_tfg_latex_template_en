\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tfg_coverpage}[2026/05/25 v2.0.1 UC3M TFG cover page]

% =====================================================================
%  COVER PAGE
%  ---------------------------------------------------------------------
%  Provides \makecover, which builds the official-style cover from the
%  variables defined in tfg_vars.tex. The colour azulUC3M is defined in
%  tfg_uc3m.sty, which loads this package.
% =====================================================================

\RequirePackage{graphicx}
\RequirePackage{svg}                % Vector logos
\RequirePackage{float}             % [H] float placement
\RequirePackage{ifthen}

% ---------------------------------------------------------------------
%  License notice printed at the bottom of the cover.
%  Driven by \licenseType in tfg_vars.tex (values: cc / reserved).
%  Add more license types below following the same pattern.
% ---------------------------------------------------------------------
\newcommand{\license}[1]{%
  \ifthenelse{\equal{#1}{cc}}{%
    % Creative Commons (recommended option): small logo to the LEFT of the
    % text and discreet text (~10 pt) so it does not stand out.
    \noindent
    \begin{minipage}[c]{2.9cm}%
      \includesvg[height=0.95cm]{images/coverpage/creativecommons_by-nc-nd.eu.svg}%
    \end{minipage}%
    \hspace{0.3cm}%
    \begin{minipage}[c]{\dimexpr\linewidth-3.3cm\relax}%
      {\fontsize{10}{12}\selectfont\raggedright
       This work is licensed under the Creative Commons\\
       \textbf{Attribution - NonCommercial - NoDerivatives} license.\par}%
    \end{minipage}%
  }{}%
  \ifthenelse{\equal{#1}{reserved}}{%
    {\fontsize{10}{12}\selectfont All rights reserved.\par}%
  }{}%
}

% ---------------------------------------------------------------------
%  \makecover - builds the cover page.
% ---------------------------------------------------------------------
\newcommand{\makecover}{%
\begin{titlepage}
  \begin{sffamily}
  \color{azulUC3M}
  \begin{center}
    % University logo
    \begin{figure}[H]
      \makebox[\textwidth][c]{\includesvg[width=16cm]{images/coverpage/UC3M_logo.svg}}
    \end{figure}
    \vspace{2.5cm}
    \begin{Large}
      \degree \\
      Academic year \academicYear \\
      \vspace{2cm}
      \textsl{\thesisType}

      \bigskip
    \end{Large}
    {\Huge \thesisTitle}\\
    \vspace*{0.5cm}
    \rule{10.5cm}{0.1mm}\\
    \vspace*{0.9cm}
    {\LARGE \thesisAuthor}\\
    \vspace*{1cm}
    \begin{Large}
      Supervisor/Advisor\\
      \thesisAdvisor \\
      \placeAndDate \\
    \end{Large}
  \end{center}
  \vfill
  \color{black}
  \license{\licenseType}
  \end{sffamily}
\end{titlepage}
}

\endinput
